<?xml version="1.0" encoding="utf-8"?>
<klayout-macro>
 <description>klayout_centroid: register the centroid library (CC_ARRAY common-centroid PCell)</description>
 <version/>
 <category>pymacros</category>
 <prolog/>
 <epilog/>
 <doc/>
 <autorun>true</autorun>
 <autorun-early>false</autorun-early>
 <priority>2</priority>
 <shortcut/>
 <show-in-menu>false</show-in-menu>
 <group-name/>
 <menu-path/>
 <interpreter>python</interpreter>
 <dsl-interpreter-name/>
 <text>import os
import sys

# The package's python/ folder is on sys.path when it is installed as a Salt
# package; this covers "klayout -b -rm &lt;checkout&gt;/pymacros/klayout_centroid.lym".
_py = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "python")
if _py not in sys.path:
    sys.path.insert(0, _py)

import klayout_centroid
klayout_centroid.register()
</text>
</klayout-macro>
