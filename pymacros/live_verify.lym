<?xml version="1.0" encoding="utf-8"?>
<klayout-macro>
 <description>klayout-live-verify: Tools > Live verify (live DRC)</description>
 <version/>
 <category>pymacros</category>
 <prolog/>
 <epilog/>
 <doc/>
 <autorun>true</autorun>
 <autorun-early>false</autorun-early>
 <priority>5</priority>
 <shortcut/>
 <show-in-menu>false</show-in-menu>
 <group-name/>
 <menu-path/>
 <interpreter>python</interpreter>
 <dsl-interpreter-name/>
 <text>import os
import sys

_py = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "python")
if _py not in sys.path:
    sys.path.insert(0, _py)

import pya
if pya.Application.instance().main_window() is not None:
    from live_verify import ui
    ui.install()
</text>
</klayout-macro>
